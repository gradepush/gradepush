# These credentials are for the private local Compose network only.
DB_NAME=gradepush
DB_USER=gradepush
DB_PASSWORD=gradepush

# The Compose entrypoint generates and persists a random key when this is empty.
# Supply production secrets through a secret manager when deploying elsewhere.
SECRET_KEY_BASE=
CREDENTIAL_ENCRYPTION_KEY=

HOST_PORT=4000
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000
POOL_SIZE=10
DEMO_MODE=false
