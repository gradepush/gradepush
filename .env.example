# These credentials are for the private local Compose network only.
DB_NAME=gradepush
DB_USER=gradepush
DB_PASSWORD=gradepush

# The release generates and persists random keys when these are empty.
# Supply production secrets through a secret manager when deploying elsewhere.
SECRET_KEY_BASE=
CREDENTIAL_ENCRYPTION_KEY=

# Optional setup token: 32-128 printable ASCII characters without spaces.
# Set before starting the app, then enter the same value on /setup.
# Changing it before setup completes replaces the previous token and setup session.
SETUP_TOKEN=

HOST_PORT=4000
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000
POOL_SIZE=10
DEMO_MODE=false

# Optional published image, for example ghcr.io/gradepush/gradepush:<version>.
# Leave empty when building from source.
GRADEPUSH_IMAGE=
