<!DOCTYPE html>
<html lang={@locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="GradePush" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <aside
      :if={Application.get_env(:gradepush, :demo_mode, false)}
      class={[
        "demo-banner flex flex-wrap items-center justify-center gap-y-[8px] gap-x-[20px] bg-[#eef3ff] border-b",
        "border-b-[#d7e2ff] text-[#233b73] text-[13px] py-[10px] px-[20px] [&_a]:font-semibold [&_a]:underline",
        "[&_a]:underline-offset-[3px] [&_a:focus-visible]:[outline:2px_solid_currentColor]",
        "[&_a:focus-visible]:outline-offset-[3px]"
      ]}
      aria-label={gettext("Demo mode")}
    >
      <span>{gettext("Demo mode · Data is reset regularly.")}</span>
      <a href="/demo">{gettext("Switch view")}</a>
    </aside>
    {@inner_content}
  </body>
</html>
