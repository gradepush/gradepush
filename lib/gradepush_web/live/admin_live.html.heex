<.page>
  <div class="min-h-screen flex flex-col" inert={@modal != nil}>
    <a class="skip-link" href="#admin-content">{gettext("Skip to content")}</a>
    <WorkspaceLayout.header
      user={@user}
      institution={@state.name}
      action={@live_action}
      context={@live_action}
      contexts={@contexts}
      preview={@preview?}
      locale={@locale}
      language_urls={Map.new(~w(en fr), &{&1, language_url(@live_action, @section, &1)})}
    />
    <.page_content
      id="admin-content"
      tabindex="-1"
    >
      <.overview kind="institution">
        <.page_heading variant="admin">
          <div>
            <.eyebrow>
              {gettext("Administration")}
            </.eyebrow><h1>
              {if @live_action == :institution, do: @state.name, else: gettext("Platform")}
            </h1><.lead>
              {if @live_action == :institution,
                do: gettext("Manage your teaching team and classroom assignments."),
                else: gettext("Configuration and operation of your GradePush instance.")}
            </.lead>
          </div>
        </.page_heading>
        <dl
          :if={@live_action == :institution}
          class={[
            "flex mt-0 mb-[30px] mx-0 gap-[40px] [&>div]:flex [&>div]:flex-col-reverse [&>div]:gap-[2px]",
            "[&_dt]:text-muted [&_dt]:text-[12px] [&_dd]:text-[24px] [&_dd]:font-semibold [&_dd]:tracking-[-.5px]",
            "max-[760px]:gap-[28px]"
          ]}
          aria-label={gettext("Institution overview")}
        >
          <div>
            <dt>{gettext("Teachers")}</dt><dd>{length(@state.teachers)}</dd>
          </div>
          <div>
            <dt>{gettext("Classrooms")}</dt><dd>{length(@state.classrooms)}</dd>
          </div>
          <div>
            <dt>{gettext("Students")}</dt><dd>{@state.students}</dd>
          </div>
        </dl>
      </.overview>
      <%= if @live_action == :institution do %>
        <.tabs compact label={gettext("Institution sections")}>
          <.tab
            :for={
              {key, title, icon} <- [
                {"teachers", gettext("Teachers"), "hero-user-group"},
                {"classrooms", gettext("Classrooms"), "hero-rectangle-stack"},
                {"history", gettext("History"), "hero-clock"},
                {"settings", gettext("Settings"), "hero-cog-6-tooth"}
              ]
            }
            patch={base(@live_action) <> "?section=" <> key}
            active={@section == key}
          >
            <.icon name={icon} class="size-4" />{title}
          </.tab>
        </.tabs>
      <% else %>
        <.tabs compact label={gettext("Platform sections")}>
          <.tab
            :for={
              {key, title, icon} <- [
                {"configuration", gettext("Configuration"), "hero-adjustments-horizontal"},
                {"services", gettext("Services"), "hero-server-stack"},
                {"history", gettext("History"), "hero-clock"}
              ]
            }
            patch={base(@live_action) <> "?section=" <> key}
            active={@section == key}
          >
            <.icon name={icon} class="size-4" />{title}
          </.tab>
        </.tabs>
      <% end %>
      <.notice
        :if={@notice}
        kind="success"
        role="status"
      >
        {@notice}
      </.notice>
      <.notice
        :if={@error && !@modal}
        kind="error"
        role="alert"
      >
        {@error}
      </.notice>
      <div class="pt-[28px] [&>[data-ui~=toolbar]]:mt-0">
        <%= cond do %>
          <% @live_action == :platform -> %>
            <AdminComponents.platform section={@section} user={@user} platform={@platform} />
          <% @section == "teachers" -> %>
            <.list_toolbar>
              <form id="admin-search" phx-change="search" role="search">
                <.search_input
                  id="teacher-query"
                  label={gettext("Search teachers")}
                  name="query"
                  value={@query}
                  placeholder={gettext("Search teachers")}
                  phx-debounce="150"
                />
              </form>
              <.button
                variant="primary"
                phx-click={open_modal("invite")}
                disabled={GradePush.Demo.enabled?()}
                title={
                  if GradePush.Demo.enabled?(),
                    do: gettext("Invitations are disabled in demo mode.")
                }
              ><.icon
                name="hero-plus"
                class="size-4"
              />{gettext("Invite a teacher")}</.button>
            </.list_toolbar>
            <.data_list :if={visible(@state.teachers, @query) != []}>
              <.data_table kind="admin">
                <caption class="sr-only">{gettext("Institution teachers")}</caption><.list_header kind="table">
                  <tr>
                    <th scope="col">{gettext("Teacher")}</th><th scope="col">
                      {gettext("Institution role")}
                    </th><th scope="col">{gettext("Classrooms")}</th><th scope="col">
                      <span class="sr-only">{gettext("Actions")}</span>
                    </th>
                  </tr>
                </.list_header>
                <tbody>
                  <tr
                    :for={teacher <- visible(@state.teachers, @query)}
                    id={"admin-teacher-#{teacher.id}"}
                  >
                    <th scope="row">
                      <div class={[
                        "flex items-center gap-[12px] [&_strong]:flex [&_strong]:items-center [&_strong]:gap-[8px] [&>div>span]:block",
                        "[&>div>span]:text-muted [&>div>span]:text-[12px] [&>div>span]:mt-[4px]"
                      ]}>
                        <.user_avatar src={Map.get(teacher, :avatar_url)} size="small">
                          {teacher.initials}
                        </.user_avatar><div>
                          <strong>{teacher.name}<span
                            :if={teacher.id == @actor_id}
                            class="text-[11px] font-normal text-muted"
                          >{gettext("You")}</span></strong><span>@{teacher.handle}</span>
                        </div>
                      </div>
                    </th>
                    <td data-label={gettext("Institution role")}>
                      <.badge :if={teacher.admin?}>{gettext("Administrator")}</.badge>
                      <span :if={!teacher.admin?}>{gettext("Teacher")}</span>
                    </td>
                    <td data-label={gettext("Classrooms")}>
                      {AdminWorkspace.class_count(@state, teacher.id)}
                    </td>
                    <td class="text-right max-[760px]:col-span-full max-[760px]:border-t max-[760px]:border-t-line max-[760px]:pt-[12px]!">
                      <.button
                        size="compact"
                        phx-click={open_modal("member", teacher.id)}
                        aria-label={gettext("Manage %{name}", name: teacher.name)}
                      >{gettext("Manage")}<.icon name="hero-chevron-right" class="size-3" /></.button>
                    </td>
                  </tr>
                </tbody>
              </.data_table>
            </.data_list>
            <.empty_state :if={visible(@state.teachers, @query) == []}>
              <.icon name="hero-user-group" class="size-8" /><h3>
                {gettext("No matching teachers")}
              </h3><p>{gettext("Try another name or GitHub username.")}</p>
            </.empty_state>
          <% @section == "classrooms" -> %>
            <div class={[
              "flex justify-between items-start mb-[20px] gap-[20px] [&_h2]:text-[16px] [&_h2]:font-semibold",
              "[&_p]:text-[13px] [&_p]:text-muted [&_p]:mt-[6px] [&_p]:leading-[1.6]"
            ]}>
              <div>
                <h2>{gettext("All classrooms")}</h2><p>
                  {gettext("Assign teachers without accessing assignments or student work.")}
                </p>
              </div>
            </div>
            <.data_list>
              <.data_table kind="admin">
                <caption class="sr-only">{gettext("Institution classrooms")}</caption><.list_header kind="table">
                  <tr>
                    <th scope="col">{gettext("Classroom")}</th><th scope="col">
                      {gettext("Teachers")}
                    </th><th scope="col">{gettext("Students")}</th><th scope="col">
                      <span class="sr-only">{gettext("Actions")}</span>
                    </th>
                  </tr>
                </.list_header>
                <tbody>
                  <tr :for={classroom <- @state.classrooms} id={"admin-class-#{classroom.id}"}>
                    <th scope="row">
                      <strong>{local(classroom.title, @locale)}</strong><span class="block text-muted text-[12px] mt-[4px]">{classroom.code}</span>
                    </th>
                    <td data-label={gettext("Teachers")}>
                      <div class="grid text-[12px] gap-[4px]">
                        <span :for={id <- classroom.teachers}>{AdminWorkspace.teacher(@state, id).name}</span>
                      </div>
                    </td>
                    <td data-label={gettext("Students")}>{classroom.students}</td>
                    <td class="text-right max-[760px]:col-span-full max-[760px]:border-t max-[760px]:border-t-line max-[760px]:pt-[12px]!">
                      <.button
                        size="compact"
                        phx-click={open_modal("staff", classroom.id)}
                        aria-label={
                          gettext("Assign teachers to %{classroom}",
                            classroom: local(classroom.title, @locale)
                          )
                        }
                      ><.icon name="hero-user-plus" class="size-4" />{gettext("Assign")}</.button>
                    </td>
                  </tr>
                </tbody>
              </.data_table>
            </.data_list>
          <% @section == "history" -> %>
            <AdminComponents.history events={@state.history} />
          <% @section == "settings" -> %>
            <.panel>
              <.panel_heading>
                <.icon name="hero-building-library" class="size-5" /><div>
                  <h2>{gettext("Institution identity")}</h2><p>
                    {gettext("This name is visible to everyone in your institution.")}
                  </p>
                </div>
              </.panel_heading>
              <form
                id="institution-form"
                class="grid max-w-[660px] p-[24px] gap-[18px] max-[760px]:p-[18px]"
                phx-submit="save_institution"
              >
                <.field>
                  {gettext("Institution name")}<.input
                    name="institution[name]"
                    required
                    maxlength="100"
                    value={@state.name}
                  />
                </.field><.modal_actions>
                  <.button type="submit" variant="primary" phx-disable-with={gettext("Saving…")}>{gettext(
                    "Save changes"
                  )}</.button>
                </.modal_actions>
              </form>
            </.panel>
            <.panel>
              <.panel_heading>
                <.icon name="hero-link" class="size-5" />
                <div>
                  <h2>{gettext("Institution links")}</h2>
                  <p>
                    {gettext(
                      "These links appear in the footer. Leave a field empty to hide its link."
                    )}
                  </p>
                </div>
              </.panel_heading>
              <.form
                for={@footer_form}
                id="footer-form"
                class="grid max-w-[660px] p-[24px] gap-[18px] max-[760px]:p-[18px]"
                phx-submit="save_footer"
              >
                <.field_hint id="footer-url-help">
                  {gettext("Use HTTPS links. Assistance also accepts mailto:email@example.org.")}
                </.field_hint>
                <.input
                  :for={
                    {field, label} <- [
                      {:support_url, gettext("Assistance")},
                      {:privacy_url, gettext("Privacy")},
                      {:accessibility_url, gettext("Accessibility")},
                      {:terms_url, gettext("Terms of use")}
                    ]
                  }
                  field={@footer_form[field]}
                  type="url"
                  label={label}
                  maxlength="2048"
                  aria-describedby="footer-url-help"
                />
                <.modal_actions>
                  <.button type="submit" variant="primary" phx-disable-with={gettext("Saving…")}>{gettext(
                    "Save changes"
                  )}</.button>
                </.modal_actions>
              </.form>
            </.panel>
        <% end %>
      </div>
    </.page_content>
    <WorkspaceLayout.footer context={@live_action} links={@footer_links} />
  </div>
  <.modal
    :if={@modal}
    id="admin-modal"
    dialog_id="admin-dialog"
    title_id="admin-modal-title"
    title={modal_title(@modal)}
    close_id="admin-modal-close"
    initial_focus={JS.focus(to: "#admin-modal-close")}
  >
    <.notice
      :if={@error}
      kind="error"
      role="alert"
    >
      {@error}
    </.notice>
    <%= case @modal do %>
      <% {"invite", _} -> %>
        <p>
          {gettext(
            "Share this link with a colleague to let them join the institution as a teacher."
          )}
        </p>
        <ClassroomComponents.invitation_link
          id="teacher-invitation"
          label={gettext("Teacher invitation link")}
          url={@invitation_url}
          status={@copy_status}
        />
        <p :if={@preview?} class="text-muted text-[12px] mt-[16px] mb-0 mx-0">
          {gettext("Example link only. Invitations are not active in this preview.")}
        </p>
        <.modal_actions>
          <.button phx-click="close">{gettext("Close")}</.button>
        </.modal_actions>
      <% {"member", id} -> %>
        <% member = AdminWorkspace.teacher(@state, id) %>
        <div class={[
          "flex items-center pt-0 pb-[24px] px-0 gap-[12px] [&_strong]:text-[14px] [&_strong]:font-[550]",
          "[&_p]:text-muted [&_p]:text-[12px]"
        ]}>
          <.user_avatar src={Map.get(member, :avatar_url)} size="default">
            {member.initials}
          </.user_avatar><div>
            <strong>{member.name}</strong><p>@{member.handle}</p>
          </div>
        </div>
        <form
          id="member-form"
          class="grid gap-[18px]"
          phx-submit="save_role"
        >
          <.field>
            {gettext("Institution role")}
            <.input
              type="select"
              name="member[role]"
              disabled={id == @actor_id}
            >
              <option value="teacher" selected={!member.admin?}>{gettext("Teacher")}</option><option
                value="admin"
                selected={member.admin?}
              >
                {gettext("Administrator")}
              </option>
            </.input>
          </.field><.field_hint>
            {gettext(
              "Administrators manage the institution, without access to classroom content."
            )}
          </.field_hint>
          <.modal_actions :if={id != @actor_id}>
            <.button type="button" phx-click="close">{gettext("Cancel")}</.button><.button
              type="submit"
              variant="primary"
            >{gettext("Save changes")}</.button>
          </.modal_actions>
        </form>
        <div
          :if={id != @actor_id}
          class="mt-[24px] pt-[12px] border-t border-t-line"
        >
          <.button variant="text-danger" phx-click="confirm_remove">{gettext(
            "Remove from institution"
          )}</.button>
        </div>
        <p
          :if={id == @actor_id}
          class="text-muted text-[12px] mt-[16px] mb-0 mx-0"
        >
          {gettext("Ask another administrator to change your role.")}
        </p>
      <% {"remove", id} -> %>
        <p id="member-removal-question" phx-mounted={JS.focus(to: "#cancel-member-removal")}>
          {gettext("Remove %{name} from the institution?",
            name: AdminWorkspace.teacher(@state, id).name
          )}
        </p>
        <p class="rounded-[7px] bg-[#f6f8fb] mt-[16px] mb-[22px] text-[13px] p-[14px] mx-0">
          {gettext("Their GitHub repositories and access will be kept.")}
        </p>
        <.notice
          :if={AdminWorkspace.class_count(@state, id) > 0}
          kind="error"
        >
          {gettext("Reassign this teacher’s classrooms before removing them.")}
        </.notice>
        <.modal_actions>
          <.button id="cancel-member-removal" phx-click="close">{gettext("Cancel")}</.button><.button
            variant="danger"
            phx-click="remove_member"
            disabled={AdminWorkspace.class_count(@state, id) > 0}
          >{gettext("Remove")}</.button>
        </.modal_actions>
      <% {"staff", id} -> %>
        <% classroom = AdminWorkspace.classroom(@state, id) %>
        <p class="font-[550] mb-[24px] [&_span]:block [&_span]:font-normal [&_span]:text-[12px]">
          {local(classroom.title, @locale)}<span>{classroom.code}</span>
        </p>
        <form
          id="staff-form"
          class="grid gap-[18px]"
          phx-submit="save_staff"
        >
          <.field>
            {gettext("Teacher to assign")}
            <.input type="select" name="staff[teacher]" required>
              <option value="">
                {gettext("Choose a teacher")}
              </option><option
                :for={teacher <- AdminWorkspace.candidates(@state, classroom, @actor_id)}
                value={teacher.id}
              >
                {teacher.name}
              </option>
            </.input>
          </.field>
          <.field>
            {gettext("Staffing action")}
            <.input type="select" name="staff[replace]">
              <option value="">
                {gettext("Add alongside current teachers")}
              </option><option :for={id <- classroom.teachers} value={id}>
                {gettext("Replace %{name}", name: AdminWorkspace.teacher(@state, id).name)}
              </option>
            </.input>
          </.field>
          <.field_hint>
            {gettext("You cannot assign yourself. A classroom teacher can invite you.")}
          </.field_hint>
          <.modal_actions>
            <.button type="button" phx-click="close">{gettext("Cancel")}</.button><.button
              type="submit"
              variant="primary"
              phx-disable-with={gettext("Saving…")}
            >{gettext("Confirm assignment")}</.button>
          </.modal_actions>
        </form>
    <% end %>
  </.modal>
</.page>
