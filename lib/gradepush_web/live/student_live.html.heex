<.page>
  <div class="min-h-screen flex flex-col">
    <a class="skip-link" href="#student-content">{gettext("Skip to content")}</a>
    <WorkspaceLayout.header
      user={@user}
      institution={@institution}
      action={@live_action}
      context={:learning}
      contexts={@contexts}
      preview={false}
      locale={@locale}
      language_urls={Map.new(~w(en fr), &{&1, @path <> "?locale=" <> &1})}
    />
    <.page_content
      id="student-content"
      student
      tabindex="-1"
    >
      <%= cond do %>
        <% @live_action == :index -> %>
          <.page_heading>
            <div>
              <.eyebrow>
                {gettext("Learning")}
              </.eyebrow><h1>{gettext("My classrooms")}</h1>
            </div>
          </.page_heading>
          <.empty_state :if={@classes == []}>
            <.icon name="hero-academic-cap" class="size-8" />
            <h2>{gettext("No classrooms yet")}</h2>
            <p>
              {gettext(
                "Use an invitation link from your teacher to join a classroom or accept an assignment."
              )}
            </p>
          </.empty_state>
          <ClassroomComponents.grouped_classes :let={classroom} classes={@classes}>
            <ClassroomComponents.card
              path={"/student/classrooms/#{classroom.slug}"}
              title={classroom.title}
              code={classroom.code}
              description={classroom.description}
              assignments={classroom.assignments_count}
              teachers={Enum.map(classroom.teachers, &Presentation.user(&1.user))}
            />
          </ClassroomComponents.grouped_classes>
        <% is_nil(@classroom) or (@live_action == :assignment and is_nil(@assignment)) -> %>
          <.empty_state>
            <h1>{gettext("This page is not available.")}</h1><.button navigate="/student/classrooms">{gettext(
              "My classrooms"
            )}</.button>
          </.empty_state>
        <% @live_action == :show -> %>
          <ClassroomComponents.breadcrumbs items={[
            {gettext("Classrooms"), "/student/classrooms"},
            {@classroom.title, nil}
          ]} />
          <.page_heading>
            <div>
              <.eyebrow :if={@classroom.code not in [nil, ""]}>
                {@classroom.code}
              </.eyebrow><h1>
                {@classroom.title}
              </h1><.lead>
                {@classroom.description}
              </.lead>
            </div>
          </.page_heading>
          <.classroom_meta>
            <span :if={Presentation.classroom_term(@classroom) != ""}><.icon
              name="hero-calendar-days"
              class="size-4"
            />{Presentation.classroom_term(@classroom)}</span>
            <span><.icon name="hero-user-group" class="size-4" />{Enum.map_join(
              @classroom.teachers,
              ", ",
              &Presentation.user(&1.user).name
            )}</span>
          </.classroom_meta>
          <.list_toolbar>
            <h2>{gettext("Assignments")}</h2><span class="text-[13px] text-muted">{length(
              @assignments
            )}</span>
          </.list_toolbar>
          <.empty_state :if={@assignments == []}>
            <p>{gettext("No assignments yet")}</p>
          </.empty_state>
          <.data_list :if={@assignments != []}>
            <.list_header kind="student_assignments">
              <span>{gettext("Assignment")}</span><span>{gettext("Deadline")}</span><span>{gettext(
                "Latest push"
              )}</span>
            </.list_header>
            <.list_row
              :for={entry <- @assignments}
              patch={assignment_path(@classroom, entry.assignment)}
              kind="student_assignments"
            >
              <div class="flex items-center min-w-0 gap-[14px] max-[760px]:col-span-full">
                <span class="text-icon inline-flex"><.icon
                  name="hero-document-text"
                  class="size-5"
                /></span>
                <div>
                  <h3>{entry.assignment.title}</h3><p :if={!entry.subject}>
                    {gettext("Not accepted")}
                  </p>
                </div>
              </div>
              <div class="wrap-anywhere text-[13px] text-caption">
                <span
                  data-ui="mobile-label"
                  class="hidden max-[760px]:block max-[760px]:text-[11px] max-[760px]:text-muted max-[760px]:mb-[3px]"
                >{gettext("Deadline")}</span>{due(deadline(entry.assignment, entry.subject))}
              </div>
              <div class="wrap-anywhere text-[13px] text-caption">
                <span
                  data-ui="mobile-label"
                  class="hidden max-[760px]:block max-[760px]:text-[11px] max-[760px]:text-muted max-[760px]:mb-[3px]"
                >{gettext("Latest push")}</span>{push_time(entry.latest_push)}
              </div>
            </.list_row>
          </.data_list>
        <% true -> %>
          <ClassroomComponents.breadcrumbs items={[
            {gettext("Classrooms"), "/student/classrooms"},
            {@classroom.title, "/student/classrooms/#{@classroom.slug}"},
            {@assignment.title, nil}
          ]} />
          <.overview kind="student">
            <.page_heading variant="student">
              <div>
                <.eyebrow>
                  {gettext("Assignment")}
                </.eyebrow>
                <h1>{@assignment.title}</h1>
                <.lead class="flex items-center gap-[8px] [&>span]:shrink-0">
                  <.icon name="hero-calendar-days" class="size-4" />{deadline_label(
                    deadline(@assignment, @subject)
                  )}
                </.lead>
              </div>
              <.button
                :if={repository_url(@repository)}
                href={repository_url(@repository)}
                variant="primary"
                target="_blank"
                rel="noopener noreferrer"
              ><.icon name="hero-arrow-top-right-on-square" class="size-4" />{gettext(
                "Open repository"
              )}</.button>
            </.page_heading>
            <.assignment_facts>
              <span><.icon name="hero-user-group" class="size-4" />{if @assignment.kind == "team",
                do: gettext("Team assignment"),
                else: gettext("Individual assignment")}</span>
              <span :if={@subject && @subject.team} data-team class="[&_strong]:font-[550]">
                <strong>{@subject.team.name}</strong>
                <span>{team_members(@subject.team)}</span>
              </span>
              <span :if={@subject}><.icon name="hero-arrow-up-tray" class="size-4" />{gettext(
                "Latest push"
              )}: {push_time(@latest_push)}</span>
            </.assignment_facts>
          </.overview>
          <.panel :if={!@subject}>
            <div class="text-muted py-[20px] px-[22px] [&_p]:m-0 max-[760px]:p-[18px]">
              <p>
                {gettext(
                  "Use your teacher’s assignment invitation to accept this assignment and create your repository."
                )}
              </p>
            </div>
          </.panel>
          <.panel :if={@subject && !repository_url(@repository)}>
            <div class="text-muted py-[20px] px-[22px] [&_p]:m-0 max-[760px]:p-[18px]">
              <p role="status">
                {if repository_failed?(@repository),
                  do:
                    gettext(
                      "Your repository could not be created. Ask your teacher to check the GitHub connection and retry."
                    ),
                  else:
                    gettext("Your repository is being prepared. This page updates automatically.")}
              </p>
            </div>
          </.panel>
          <.panel>
            <.panel_heading>
              <h2>{gettext("Assignment instructions")}</h2>
            </.panel_heading>
            <div class="leading-[1.75] wrap-anywhere markdown p-[22px] max-[760px]:p-[18px]">
              <%= if @assignment.instructions in [nil, ""] do %>
                <p class="text-muted">{gettext("No instructions provided.")}</p>
              <% else %>
                {Markdown.render(@assignment.instructions, 2)}
              <% end %>
            </div>
          </.panel>
          <.panel :if={@assignment.autograding_enabled}>
            <.panel_heading>
              <h2>{gettext("Automatic tests")}</h2>
            </.panel_heading>
            <GradingComponents.results
              id="student-test-results"
              tests={@assignment.tests}
              subject={@subject}
            />
          </.panel>
      <% end %>
    </.page_content>
    <WorkspaceLayout.footer context={:learning} links={@footer_links} />
  </div>
</.page>
