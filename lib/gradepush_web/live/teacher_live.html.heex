<div class="class-preview">
  <div class="cp-shell" inert={@modal != nil}>
    <a class="skip-link" href="#class-content">{gettext("Skip to content")}</a>
    <WorkspaceLayout.header
      user={@user}
      contexts={
        if(@preview?,
          do: [:teaching, :institution, :platform],
          else: GradePushWeb.Presentation.contexts(@current_user)
        )
      }
      institution={@institution}
      action={@live_action}
      locale={@locale}
      preview={@preview?}
      language_urls={
        Map.new(~w(fr en), &{&1, locale_url(@path, @tab, @assignment_tab, @settings_section, &1)})
      }
    />
    <main id="class-content" class="cp-main" tabindex="-1">
      <p :if={@error && !@modal && @live_action != :settings} class="cp-error" role="alert">
        {@error}
      </p>
      <%= cond do %>
        <% @live_action == :settings -> %>
          <AccountComponents.settings
            section={@settings_section}
            user={@user}
            organizations={@organizations}
            sharing_teachers={@sharing_teachers}
            notice={@notice}
            error={@error}
          />
        <% @live_action == :signed_out -> %>
          <AccountComponents.signed_out preview={@preview?} />
        <% @live_action == :index -> %>
          <div class="cp-heading">
            <div>
              <p class="cp-context">{gettext("Teaching")}</p><h1>{gettext("My classrooms")}</h1><p class="cp-lead">
                {gettext("A space for each course, shared with your students and colleagues.")}
              </p>
            </div>
            <button class="cp-button cp-primary" phx-click={open_modal("create")}><.icon
              name="hero-plus"
              class="size-4"
            />{gettext("Create a classroom")}</button>
          </div>
          <div class="cp-section-label">
            <span>{ngettext(
              "%{count} classroom",
              "%{count} classrooms",
              if(@scenario == "empty", do: 0, else: length(@classes))
            )}</span>
          </div>
          <div :if={@scenario != "empty"} class="cp-grid">
            <.link
              :for={classroom <- @classes}
              patch={"/classrooms/#{classroom.slug}"}
              class="cp-class-card"
            >
              <div class="cp-card-top">
                <span class="cp-course-code">{classroom.code}</span><.icon
                  name="hero-arrow-up-right"
                  class="size-4"
                />
              </div>
              <h2>{local(classroom.title, @locale)}</h2>
              <p :if={classroom.session != ""} class="cp-card-session">
                <.icon name="hero-calendar-days" class="size-4" />{classroom.session}
              </p>
              <p class="cp-card-description">{local(classroom.description, @locale)}</p>
              <div class="cp-card-counts">
                <span><.icon name="hero-user-group" class="size-4" />{classroom.students} {gettext(
                  "students"
                )}</span><span><.icon name="hero-document-text" class="size-4" />{ngettext(
                  "%{count} assignment",
                  "%{count} assignments",
                  classroom.assignments
                )}</span>
              </div>
              <div class="cp-card-teachers">
                <div class="cp-avatar-stack">
                  <span
                    :for={teacher <- classroom.teachers}
                    class="cp-small-avatar"
                    title={teacher.name}
                  >{teacher.initials}</span>
                </div><span>{Enum.map_join(classroom.teachers, ", ", & &1.name)}</span>
              </div>
            </.link>
          </div>
          <div :if={@scenario == "empty"} class="cp-empty">
            <.icon name="hero-academic-cap" class="size-8" /><h2>
              {gettext("Your first classroom starts here")}
            </h2><p>
              {gettext("Create a classroom, then share its invitation link with your students.")}
            </p><button class="cp-button cp-primary" phx-click={open_modal("create")}>{gettext(
              "Create a classroom"
            )}</button>
          </div>
        <% @live_action in [:new_assignment, :edit_assignment] and @classroom != nil and (@live_action == :new_assignment or @assignment != nil) -> %>
          <AssignmentEditor.page
            form={@assignment_form}
            classroom={@classroom}
            assignment={@assignment}
            locale={@locale}
            templates={@templates}
            preview={@instructions_preview}
            demo={@preview?}
          />
        <% @live_action == :assignment and @classroom != nil and @assignment != nil -> %>
          <AssignmentComponents.page
            details={@assignment_details}
            tab={@assignment_tab}
            assignment={@assignment}
            classroom={@classroom}
            locale={@locale}
            query={@query}
            filter={@submission_filter}
            preview={@preview?}
            teams={@teams}
            members={@members}
          />
        <% @live_action in [:assignment, :new_assignment, :edit_assignment] -> %>
          <div class="cp-empty">
            <h1>{gettext("Assignment not found")}</h1><.link
              patch={if @classroom, do: "/classrooms/#{@classroom.slug}", else: "/classrooms"}
              class="cp-button"
            >{gettext("Back to classrooms")}</.link>
          </div>
        <% @classroom != nil -> %>
          <ClassroomComponents.breadcrumbs items={[
            {gettext("Classrooms"), "/classrooms"},
            {local(@classroom.title, @locale), nil}
          ]} />
          <div class="cp-heading cp-class-heading">
            <div>
              <p :if={@classroom.code != ""} class="cp-context">
                {@classroom.code}
              </p><h1>{local(@classroom.title, @locale)}</h1><p class="cp-lead">
                {local(@classroom.description, @locale)}
              </p>
            </div>
            <button class="cp-button" phx-click={open_modal("edit")}><.icon
              name="hero-pencil-square"
              class="size-4"
            />{gettext("Edit classroom")}</button>
          </div>
          <div class="cp-class-meta">
            <span :if={@classroom.session != ""} class="cp-class-session">
              <.icon name="hero-calendar-days" class="size-4" />{@classroom.session}
            </span>
            <span><.icon name="hero-code-bracket" class="size-4" />{@classroom.organization}</span><button
              phx-click={open_modal("teachers")}
              class="cp-teachers-link"
            ><.icon name="hero-user-group" class="size-4" />{Enum.map_join(
              @classroom.teachers,
              ", ",
              & &1.name
            )}<.icon name="hero-chevron-down" class="size-3" /><span class="sr-only">{gettext(
              "Manage teachers"
            )}</span></button>
          </div>
          <nav class="cp-tabs" aria-label={gettext("Classroom sections")}>
            <.link
              patch={"/classrooms/#{@classroom.slug}"}
              aria-current={if @tab == "assignments", do: "page"}
              class={if @tab == "assignments", do: "is-active"}
            ><.icon name="hero-document-text" class="size-4" />{gettext("Assignments")}<span class="cp-tab-count">{@classroom.assignments}</span></.link>
            <.link
              patch={"/classrooms/#{@classroom.slug}?tab=students"}
              aria-current={if @tab == "students", do: "page"}
              class={if @tab == "students", do: "is-active"}
            ><.icon name="hero-user-group" class="size-4" />{gettext("Students")}<span class="cp-tab-count">{@classroom.students}</span></.link>
          </nav>
          <p :if={@notice} class="cp-notice" role="status">{@notice}</p>
          <%= if @tab == "assignments" do %>
            <div class="cp-toolbar">
              <h2>{gettext("Assignments")}</h2><.link
                class="cp-button cp-primary"
                patch={"/classrooms/#{@classroom.slug}/assignments/new"}
              ><.icon name="hero-plus" class="size-4" />{gettext("New assignment")}</.link>
            </div>
            <div :if={@classroom.assignments > 0} class="cp-assignment-list">
              <div class="cp-assignment-labels">
                <span>{gettext("Assignment")}</span><span>{gettext("Deadline")}</span><span>{gettext(
                  "Acceptances"
                )}</span>
              </div>
              <.link
                :for={assignment <- classroom_assignments(@assignments, @classroom)}
                patch={"/classrooms/#{@classroom.slug}/assignments/#{assignment.key}"}
                class="cp-assignment"
              >
                <div class="cp-assignment-name">
                  <span class="cp-file-icon"><.icon name="hero-document-text" class="size-5" /></span><div>
                    <h3>{local(assignment.title, @locale)}</h3><p>
                      {local(assignment.kind, @locale)}
                    </p>
                  </div>
                </div>
                <div class="cp-due">
                  <span class="cp-mobile-label">{gettext("Deadline")}</span>{if assignment.status ==
                                                                                  :draft,
                                                                                do:
                                                                                  gettext(
                                                                                    "No deadline"
                                                                                  ),
                                                                                else:
                                                                                  local(
                                                                                    assignment.due,
                                                                                    @locale
                                                                                  )}
                </div>
                <div class="cp-accepted">
                  <span class="cp-mobile-label">{gettext("Acceptances")}</span>{assignment.submitted}<span> / {assignment.total}</span>
                </div>
              </.link>
            </div>
            <div :if={@classroom.assignments == 0} class="cp-empty">
              <.icon name="hero-document-plus" class="size-8" /><h2>
                {gettext("No assignments yet")}
              </h2><p>{gettext("Your classroom is ready for its first assignment.")}</p>
            </div>
          <% else %>
            <div class="cp-toolbar">
              <form id="student-search" phx-change="search" role="search">
                <label class="cp-search"><.icon name="hero-magnifying-glass" class="size-4" /><span class="sr-only">{gettext(
                  "Search students"
                )}</span><input
                  name="query"
                  type="search"
                  placeholder={gettext("Search students")}
                  value={@query}
                  phx-debounce="150"
                /></label>
              </form><button
                class="cp-button cp-primary"
                phx-click={open_modal("invite")}
                disabled={GradePush.Demo.enabled?()}
                title={
                  if GradePush.Demo.enabled?(),
                    do: gettext("Invitations are disabled in demo mode.")
                }
              ><.icon
                name="hero-link"
                class="size-4"
              />{gettext("Invite students")}</button>
            </div>
            <div :if={visible_students(@classroom, @query) != []} class="cp-student-list">
              <div class="cp-student-labels">
                <span>{gettext("Student")}</span><span>{gettext("Student ID")}</span><span>GitHub</span><span></span>
              </div>
              <div
                :for={student <- visible_students(@classroom, @query)}
                id={"student-#{student.handle}"}
                class="cp-student"
              >
                <div class="cp-student-name">
                  <span class="cp-small-avatar">{student.initials}</span><strong>{student.name}</strong>
                </div><span class="cp-student-id">{student.identifier}</span><a
                  class="cp-handle cp-profile-link"
                  href={"https://github.com/#{student.handle}"}
                  target="_blank"
                  rel="noopener noreferrer"
                >@{student.handle}</a><button
                  class="cp-remove"
                  aria-label={gettext("Remove %{name}", name: student.name)}
                  phx-click={
                    JS.push_focus()
                    |> JS.push("open", value: %{kind: "remove", handle: student.handle})
                  }
                ><.icon name="hero-x-mark" class="size-4" /></button>
              </div>
            </div>
            <div :if={visible_students(@classroom, @query) == []} class="cp-empty">
              <.icon name="hero-user-group" class="size-8" /><h2>
                {if @query == "",
                  do: gettext("No students yet"),
                  else: gettext("No matching students")}
              </h2><p>
                {if @query == "",
                  do: gettext("Share the classroom link to let your students join."),
                  else: gettext("Try another name, student ID, or GitHub username.")}
              </p>
            </div>
          <% end %>
        <% true -> %>
          <div class="cp-empty">
            <h1>{gettext("Classroom not found")}</h1><.link patch="/classrooms" class="cp-button">{gettext(
              "My classrooms"
            )}</.link>
          </div>
      <% end %>
    </main>
    <WorkspaceLayout.footer />
  </div>
  <div
    :if={@modal}
    id="class-modal"
    class="cp-modal-backdrop"
    phx-window-keydown="close"
    phx-key="Escape"
    phx-remove={JS.pop_focus()}
  >
    <.focus_wrap
      id="class-dialog"
      class={["cp-modal", modal?(@modal, "test_results") && "cp-results-modal"]}
      role="dialog"
      aria-modal="true"
      aria-labelledby="class-modal-title"
      phx-mounted={JS.focus_first()}
    >
      <div class="cp-modal-heading">
        <h2 id="class-modal-title" tabindex="-1">{modal_title(@modal)}</h2><button
          class="cp-remove"
          phx-click="close"
          aria-label={gettext("Close")}
        ><.icon name="hero-x-mark" class="size-5" /></button>
      </div>
      <p :if={@error} class="cp-error" role="alert">{@error}</p>
      <p :if={@notice} class="cp-notice" role="status">{@notice}</p>
      <%= cond do %>
        <% modal?(@modal, "test_results") -> %>
          <% subject = Enum.find(@assignment_subjects, &(&1.id == elem(@modal, 1))) %>
          <%= if subject do %>
            <p class="cp-grading-owner">
              {if subject.team,
                do: subject.team.name,
                else: subject.user.student_name || subject.user.name || subject.user.login}
            </p>
            <GradingComponents.results
              id="submission-test-results"
              tests={@assignment_record.tests}
              subject={subject}
            />
          <% else %>
            <p>{gettext("This submission is no longer available.")}</p>
          <% end %>
        <% modal?(@modal, "create") or modal?(@modal, "edit") -> %>
          <form phx-submit="save_class" id="class-form" class="cp-form">
            <label>{gettext("Classroom name")}<input
              name="class[name]"
              required
              maxlength="100"
              value={editing_value(assigns, :title)}
              placeholder={gettext("e.g. Programming I")}
            /></label>
            <label>{gettext("Course code (optional)")}<input
              name="class[code]"
              maxlength="30"
              value={editing_value(assigns, :code)}
              placeholder="420-110"
            /></label>
            <label>{gettext("Session (optional)")}<input
              name="class[session]"
              maxlength="80"
              value={editing_value(assigns, :session)}
              placeholder={gettext("e.g. Fall 2026")}
            /></label>
            <label>{gettext("Description (optional)")}<textarea
              name="class[description]"
              rows="3"
              maxlength="500"
            >{editing_value(assigns, :description)}</textarea></label>
            <label>{gettext("GitHub organization")}<select
              name="class[github_connection_id]"
              required
              disabled={
                classroom_organization_locked?(assigns) or
                  (classroom_organizations(@organizations) == [] and not @preview?)
              }
            ><option
              value=""
              selected={editing_value(assigns, :github_connection_id) in [nil, ""]}
            >
              {gettext("Select an organization")}
            </option><option
              :for={organization <- classroom_organizations(@organizations)}
              value={if(is_map(organization), do: organization.id, else: organization)}
              selected={
                to_string(editing_value(assigns, :github_connection_id) || "") ==
                  to_string(if(is_map(organization), do: organization.id, else: organization))
              }
            >
              {if(is_map(organization), do: organization.login, else: organization)}
            </option></select></label>
            <p :if={classroom_organization_locked?(assigns)} class="cp-field-help">
              {gettext(
                "The GitHub organization cannot change after assignments have been created."
              )}
            </p>
            <p
              :if={classroom_organizations(@organizations) == [] and not @preview?}
              class="cp-field-help"
            >
              {gettext("Connect a GitHub organization in settings before creating a classroom.")}
              <.link patch="/teacher/settings?section=organizations">{gettext(
                "Open organization settings"
              )}</.link>
            </p>
            <div class="cp-modal-actions">
              <button type="button" class="cp-button" phx-click="close">{gettext("Cancel")}</button><button class="cp-button cp-primary">{if modal?(
                                                                                                                                               @modal,
                                                                                                                                               "create"
                                                                                                                                             ),
                                                                                                                                             do:
                                                                                                                                               gettext(
                                                                                                                                                 "Create classroom"
                                                                                                                                               ),
                                                                                                                                             else:
                                                                                                                                               gettext(
                                                                                                                                                 "Save changes"
                                                                                                                                               )}</button>
            </div>
          </form>
        <% modal?(@modal, "assignment_invite") -> %>
          <p>
            {gettext(
              "Share this link with your students. Accepting the assignment joins the classroom and creates their repository."
            )}
          </p>
          <ClassroomComponents.invitation_link
            :if={@invitation_url || @preview?}
            id="assignment-invitation"
            label={gettext("Assignment invitation link")}
            url={
              @invitation_url || "https://gradepush.example/join/assignment/#{@assignment.key}"
            }
            status={@copy_status}
          />
          <p :if={@preview?} id="assignment-invitation-note" class="cp-preview-note">
            {gettext("Example link only. Invitations are not active in this preview.")}
          </p>
          <div class="cp-modal-actions">
            <button class="cp-button" phx-click="close">{gettext("Close")}</button>
          </div>
        <% modal?(@modal, "invite") -> %>
          <p>
            {gettext(
              "Students sign in with GitHub and enter their name and student ID to join your classroom."
            )}
          </p>
          <ClassroomComponents.invitation_link
            :if={@invitation_url || @preview?}
            id="invitation"
            label={gettext("Classroom invitation link")}
            url={@invitation_url || "https://gradepush.example/join/classroom/#{@classroom.slug}"}
            status={@copy_status}
          />
          <p :if={@preview?} id="invitation-note" class="cp-preview-note">
            {gettext("Example link only. Invitations are not active in this preview.")}
          </p>
          <div class="cp-modal-actions">
            <button class="cp-button" phx-click="close">{gettext("Close")}</button>
          </div>
        <% modal?(@modal, "teachers") -> %>
          <p>{gettext("All teachers in this classroom have the same permissions.")}</p>
          <ul class="cp-teacher-list">
            <li :for={teacher <- @classroom.teachers}>
              <span class="cp-small-avatar">{teacher.initials}</span><strong>{teacher.name}</strong><span
                :if={not not_current_teacher?(teacher, assigns)}
                class="cp-you"
              >{gettext("You")}</span><button
                :if={not_current_teacher?(teacher, assigns)}
                id={teacher_remove_id(teacher)}
                class="cp-remove"
                aria-label={gettext("Remove %{name}", name: teacher.name)}
                phx-click="request_teacher_removal"
                phx-value-teacher={teacher_option_value(teacher)}
              ><.icon name="hero-x-mark" class="size-4" /></button>
            </li>
          </ul>
          <div
            :if={@pending_teacher}
            id="teacher-removal-confirmation"
            class="cp-inline-confirm"
            role="group"
            aria-labelledby="teacher-removal-question"
            phx-mounted={JS.focus(to: "#cancel-teacher-removal")}
          >
            <p id="teacher-removal-question" role="status">
              {gettext("Remove %{name} from this classroom?", name: @pending_teacher.name)}
            </p>
            <div class="cp-modal-actions">
              <button
                id="cancel-teacher-removal"
                class="cp-button"
                phx-click={
                  JS.push("cancel_teacher_removal")
                  |> JS.focus(to: "##{teacher_remove_id(@pending_teacher)}")
                }
              >{gettext("Cancel")}</button>
              <button
                class="cp-button cp-danger"
                phx-click={JS.push("remove_teacher") |> JS.focus(to: "#class-modal-title")}
              >{gettext("Remove")}</button>
            </div>
          </div>
          <form
            :if={@pending_teacher == nil and @available_classroom_teachers != []}
            phx-submit="add_teacher"
            class="cp-form"
          >
            <label>{gettext("Add a colleague")}<select name="teacher"><option
              :for={teacher <- @available_classroom_teachers}
              value={teacher_option_value(teacher)}
            >
              {teacher_name(teacher)}
            </option></select></label><button class="cp-button cp-primary">{gettext(
              "Add to classroom"
            )}</button>
          </form>
          <p :if={@preview?} class="cp-preview-note">
            {gettext("Teachers are added locally in this preview. No invitation is sent.")}
          </p>
        <% modal?(@modal, "connect_organization") -> %>
          <p>
            {gettext(
              "Authorize GradePush on GitHub to create assignment repositories in your organization."
            )}
          </p>
          <div :if={@preview?} class="cp-preview-note">
            {gettext(
              "GitHub connections are unavailable in this preview. No permissions will be changed."
            )}
          </div>
          <form
            :if={!@preview? and @available_organizations != []}
            phx-submit="connect_organization"
            class="cp-form"
          >
            <label>{gettext("Installed organization")}
            <select name="organization" required>
              <option value="" selected>{gettext("Select an organization")}</option>
              <option
                :for={organization <- @available_organizations}
                value={organization.installation_id}
              >
                {organization.login}
              </option>
            </select></label>
            <label>{gettext("Who can use this connection?")}
            <select name="sharing_scope">
              <option value="private">{gettext("Only me")}</option>
              <option value="institution">{gettext("All institution teachers")}</option>
            </select></label>
            <div class="cp-modal-actions">
              <button type="button" class="cp-button" phx-click="close">{gettext("Cancel")}</button>
              <button class="cp-button cp-primary">{gettext("Connect organization")}</button>
            </div>
          </form>
          <div :if={!@preview? and @available_organizations == []} class="cp-empty-inline">
            <p>{gettext("No GitHub organization is installed for GradePush yet.")}</p>
            <a
              :if={@github_app_install_url}
              class="cp-button cp-primary"
              href={@github_app_install_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {gettext("Install GradePush on GitHub")}<.icon
                name="hero-arrow-top-right-on-square"
                class="size-4"
              />
            </a>
            <p :if={!@github_app_install_url}>
              {gettext("Ask the platform administrator to connect GitHub first.")}
            </p>
          </div>
          <div :if={@preview? or @available_organizations == []} class="cp-modal-actions">
            <button class="cp-button" phx-click="close">{gettext("Close")}</button>
            <button :if={@preview?} class="cp-button cp-primary" disabled>{gettext(
              "Continue on GitHub"
            )}</button>
          </div>
        <% modal?(@modal, "remove") -> %>
          <p>
            {gettext("Remove %{name} from this classroom?",
              name: selected_student(@classroom, @modal).name
            )}
          </p>
          <p class="cp-removal-detail">
            {gettext(
              "Their repositories and GitHub access will be kept. If they rejoin, they will recover their existing work."
            )}
          </p>
          <div class="cp-modal-actions">
            <button class="cp-button" phx-click="close">{gettext("Cancel")}</button><button
              class="cp-button cp-danger"
              phx-click="remove_student"
            >{gettext("Remove from classroom")}</button>
          </div>
        <% modal?(@modal, "teams") -> %>
          <p>
            {gettext(
              "Assign students to teams. Students receive their team when they accept the assignment."
            )}
          </p>
          <form phx-submit="create_team" class="cp-form cp-team-create-form">
            <label>{gettext("Team name")}<input
              name="team[name]"
              required
              maxlength="100"
              placeholder={gettext("e.g. Team 1")}
            /></label><button class="cp-button cp-primary"><.icon name="hero-plus" class="size-4" />{gettext(
              "Create team"
            )}</button>
          </form>
          <div :if={@teams != []} class="cp-teacher-list cp-managed-teams">
            <section :for={team <- @teams} id={"managed-team-#{team.id}"}>
              <div class="cp-team-heading">
                <strong>{team.name}</strong><span>
                  {ngettext("%{count} student", "%{count} students", length(team.members))}
                </span>
              </div>
              <ul :if={team.members != []}>
                <li :for={student <- team.members}>
                  <span class="cp-small-avatar">{student.initials}</span><strong>{student.name}</strong>
                </li>
              </ul>
              <form
                :if={team.can_add? and unassigned_students(@members, @teams) != []}
                phx-submit="add_team_member"
                class="cp-form cp-team-member-form"
              >
                <input type="hidden" name="team_id" value={team.id} />
                <label>{gettext("Add a student")}
                <select name="student_id" required>
                  <option
                    :for={student <- unassigned_students(@members, @teams)}
                    value={student.id}
                  >
                    {student.name} (@{student.handle})
                  </option>
                </select></label><button class="cp-button">{gettext("Add to team")}</button>
              </form>
              <p :if={not team.can_add?} class="cp-field-help">
                {gettext("This team has reached its member limit.")}
              </p>
            </section>
          </div>
          <div :if={@teams == []} class="cp-empty-inline">
            {gettext("No teams yet. Create a team to start assigning students.")}
          </div>
          <div class="cp-modal-actions">
            <button class="cp-button" phx-click="close">{gettext("Done")}</button>
          </div>
        <% modal?(@modal, "deadline_extension") -> %>
          <p>
            {gettext(
              "Choose a deadline later than the assignment deadline. Clear the extension to use the original deadline."
            )}
          </p>
          <p class="cp-field-help">
            {gettext("Assignment deadline: %{date}", date: local(@assignment.due, @locale))}
          </p>
          <form
            id="deadline-extension-form"
            phx-change="validate_extension"
            phx-submit="save_extension"
            class="cp-form"
          >
            <label>
              {gettext("Revised deadline")}
              <input
                type="datetime-local"
                name="extension[deadline]"
                min={@assignment.deadline_local}
                value={@extension_params["deadline"]}
                required
              />
            </label>
            <div class="cp-modal-actions">
              <button type="button" class="cp-button" phx-click="close">{gettext("Cancel")}</button>
              <button class="cp-button cp-primary">{gettext("Save deadline")}</button>
            </div>
          </form>
          <button
            :if={extension_set?(assigns)}
            class="cp-profile-link cp-clear-extension"
            phx-click="clear_extension"
          >{gettext("Clear extension and use the assignment deadline")}</button>
      <% end %>
    </.focus_wrap>
  </div>
</div>
