<.page>
  <div class="min-h-screen flex flex-col" inert={@modal != nil}>
    <a class="skip-link" href="#class-content">{gettext("Skip to content")}</a>
    <WorkspaceLayout.header
      user={@user}
      contexts={
        if(@preview?,
          do: [:teaching, :institution, :platform],
          else: GradePushWeb.Presentation.contexts(@current_user)
        )
      }
      institution={@institution}
      action={@live_action}
      locale={@locale}
      preview={@preview?}
      language_urls={
        Map.new(~w(fr en), &{&1, locale_url(@path, @tab, @assignment_tab, @settings_section, &1)})
      }
    />
    <.page_content
      id="class-content"
      tabindex="-1"
    >
      <.notice
        :if={@error && !@modal && @live_action != :settings}
        kind="error"
        role="alert"
      >
        {@error}
      </.notice>
      <%= cond do %>
        <% @live_action == :settings -> %>
          <AccountComponents.settings
            section={@settings_section}
            user={@user}
            organizations={@organizations}
            sharing_teachers={@sharing_teachers}
            notice={@notice}
            error={@error}
          />
        <% @live_action == :signed_out -> %>
          <AccountComponents.signed_out preview={@preview?} />
        <% @live_action == :index -> %>
          <.page_heading>
            <div>
              <.eyebrow>
                {gettext("Teaching")}
              </.eyebrow><h1>{gettext("My classrooms")}</h1><.lead>
                {gettext("A space for each course, shared with your students and colleagues.")}
              </.lead>
            </div>
            <.button variant="primary" phx-click={open_modal("create")}><.icon
              name="hero-plus"
              class="size-4"
            />{gettext("Create a classroom")}</.button>
          </.page_heading>
          <ClassroomComponents.grouped_classes
            :let={classroom}
            :if={@scenario != "empty"}
            classes={@classes}
          >
            <ClassroomComponents.card
              path={"/classrooms/#{classroom.slug}"}
              title={local(classroom.title, @locale)}
              code={classroom.code}
              description={local(classroom.description, @locale)}
              students={classroom.students}
              assignments={classroom.assignments}
              teachers={classroom.teachers}
            />
          </ClassroomComponents.grouped_classes>
          <.empty_state :if={@scenario == "empty"}>
            <.icon name="hero-academic-cap" class="size-8" /><h2>
              {gettext("Your first classroom starts here")}
            </h2><p>
              {gettext("Create a classroom, then share its invitation link with your students.")}
            </p><.button variant="primary" phx-click={open_modal("create")}>{gettext(
              "Create a classroom"
            )}</.button>
          </.empty_state>
        <% @live_action in [:new_assignment, :edit_assignment] and @classroom != nil and (@live_action == :new_assignment or @assignment != nil) -> %>
          <AssignmentEditor.page
            form={@assignment_form}
            classroom={@classroom}
            assignment={@assignment}
            locale={@locale}
            templates={@templates}
            preview={@instructions_preview}
            demo={@preview?}
          />
        <% @live_action == :assignment and @classroom != nil and @assignment != nil -> %>
          <AssignmentComponents.page
            details={@assignment_details}
            tab={@assignment_tab}
            assignment={@assignment}
            classroom={@classroom}
            locale={@locale}
            query={@query}
            filter={@submission_filter}
            preview={@preview?}
            teams={@teams}
            members={@members}
          />
        <% @live_action in [:assignment, :new_assignment, :edit_assignment] -> %>
          <.empty_state>
            <h1>{gettext("Assignment not found")}</h1><.button patch={
              if @classroom, do: "/classrooms/#{@classroom.slug}", else: "/classrooms"
            }>{gettext("Back to classrooms")}</.button>
          </.empty_state>
        <% @classroom != nil -> %>
          <ClassroomComponents.breadcrumbs items={[
            {gettext("Classrooms"), "/classrooms"},
            {local(@classroom.title, @locale), nil}
          ]} />
          <.page_heading variant="classroom">
            <div>
              <.eyebrow :if={@classroom.code not in [nil, ""]}>
                {@classroom.code}
              </.eyebrow><h1>{local(@classroom.title, @locale)}</h1><.lead>
                {local(@classroom.description, @locale)}
              </.lead>
            </div>
            <.button phx-click={open_modal("edit")}><.icon
              name="hero-pencil-square"
              class="size-4"
            />{gettext("Edit classroom")}</.button>
          </.page_heading>
          <.classroom_meta>
            <span :if={Presentation.classroom_term(@classroom) != ""} data-ui="class-session">
              <.icon name="hero-calendar-days" class="size-4" />{Presentation.classroom_term(
                @classroom
              )}
            </span>
            <span><.icon name="hero-code-bracket" class="size-4" />{@classroom.organization}</span><.button
              data-ui="teachers-link"
              phx-click={open_modal("teachers")}
              variant="link"
            ><.icon name="hero-user-group" class="size-4" />{Enum.map_join(
              @classroom.teachers,
              ", ",
              & &1.name
            )}<.icon name="hero-chevron-down" class="size-3" /><span class="sr-only">{gettext(
              "Manage teachers"
            )}</span></.button>
          </.classroom_meta>
          <.tabs label={gettext("Classroom sections")}>
            <.tab
              patch={"/classrooms/#{@classroom.slug}"}
              active={@tab == "assignments"}
              count={@classroom.assignments}
            >
              <.icon name="hero-document-text" class="size-4" />{gettext("Assignments")}
            </.tab>
            <.tab
              patch={"/classrooms/#{@classroom.slug}?tab=students"}
              active={@tab == "students"}
              count={@classroom.students}
            >
              <.icon name="hero-user-group" class="size-4" />{gettext("Students")}
            </.tab>
          </.tabs>
          <.notice
            :if={@notice}
            kind="success"
            role="status"
          >
            {@notice}
          </.notice>
          <%= if @tab == "assignments" do %>
            <.list_toolbar>
              <h2>{gettext("Assignments")}</h2><.button
                variant="primary"
                patch={"/classrooms/#{@classroom.slug}/assignments/new"}
              ><.icon name="hero-plus" class="size-4" />{gettext("New assignment")}</.button>
            </.list_toolbar>
            <.data_list :if={@classroom.assignments > 0}>
              <.list_header kind="assignments">
                <span>{gettext("Assignment")}</span><span>{gettext("Deadline")}</span><span>{gettext(
                  "Acceptances"
                )}</span>
              </.list_header>
              <.list_row
                :for={assignment <- classroom_assignments(@assignments, @classroom)}
                patch={"/classrooms/#{@classroom.slug}/assignments/#{assignment.key}"}
                kind="assignments"
              >
                <div class="flex items-center min-w-0 gap-[14px] max-[760px]:col-span-full">
                  <span class="text-icon inline-flex"><.icon
                    name="hero-document-text"
                    class="size-5"
                  /></span><div>
                    <h3>{local(assignment.title, @locale)}</h3><p>
                      {local(assignment.kind, @locale)}
                    </p>
                  </div>
                </div>
                <div class="text-[13px] text-caption">
                  <span
                    data-ui="mobile-label"
                    class="hidden max-[760px]:block max-[760px]:text-[11px] max-[760px]:text-muted max-[760px]:mb-[3px]"
                  >{gettext("Deadline")}</span>{if assignment.status ==
                                                     :draft,
                                                   do: gettext("No deadline"),
                                                   else:
                                                     local(
                                                       assignment.due,
                                                       @locale
                                                     )}
                </div>
                <div class="text-[13px] tabular-nums [&>span:not([data-ui~=mobile-label])]:text-muted max-[760px]:text-right">
                  <span
                    data-ui="mobile-label"
                    class="hidden max-[760px]:block max-[760px]:text-[11px] max-[760px]:text-muted max-[760px]:mb-[3px]"
                  >{gettext("Acceptances")}</span>{assignment.submitted}<span> / {assignment.total}</span>
                </div>
              </.list_row>
            </.data_list>
            <.empty_state :if={@classroom.assignments == 0}>
              <.icon name="hero-document-plus" class="size-8" /><h2>
                {gettext("No assignments yet")}
              </h2><p>{gettext("Your classroom is ready for its first assignment.")}</p>
            </.empty_state>
          <% else %>
            <.list_toolbar>
              <form id="student-search" phx-change="search" role="search">
                <.search_input
                  id="student-query"
                  label={gettext("Search students")}
                  name="query"
                  placeholder={gettext("Search students")}
                  value={@query}
                  phx-debounce="150"
                />
              </form><.button
                variant="primary"
                phx-click={open_modal("invite")}
                disabled={GradePush.Demo.enabled?()}
                title={
                  if GradePush.Demo.enabled?(),
                    do: gettext("Invitations are disabled in demo mode.")
                }
              ><.icon
                name="hero-link"
                class="size-4"
              />{gettext("Invite students")}</.button>
            </.list_toolbar>
            <.data_list :if={visible_students(@classroom, @query) != []}>
              <.list_header kind="students">
                <span>{gettext("Student")}</span><span>{gettext("Student ID")}</span><span>GitHub</span><span></span>
              </.list_header>
              <.list_row
                :for={student <- visible_students(@classroom, @query)}
                id={"student-#{student.handle}"}
                kind="students"
              >
                <div class="flex items-center min-w-0 gap-[12px] [&_strong]:font-[550] max-[760px]:row-start-1 max-[760px]:col-start-1">
                  <.user_avatar src={Map.get(student, :avatar_url)} size="small">
                    {student.initials}
                  </.user_avatar><strong>{student.name}</strong>
                </div><span class="tabular-nums text-muted max-[760px]:row-start-2 max-[760px]:col-start-1 max-[760px]:pl-[41px] max-[760px]:text-[12px]">{student.identifier}</span><a
                  class={[
                    "text-muted wrap-anywhere underline-offset-[3px] max-[760px]:row-start-3 max-[760px]:col-start-1",
                    "max-[760px]:pl-[41px] max-[760px]:text-[12px] hover:text-brand hover:underline"
                  ]}
                  href={"https://github.com/#{student.handle}"}
                  target="_blank"
                  rel="noopener noreferrer"
                >@{student.handle}</a><.button
                  variant="icon"
                  aria-label={gettext("Remove %{name}", name: student.name)}
                  phx-click={
                    JS.push_focus()
                    |> JS.push("open", value: %{kind: "remove", handle: student.handle})
                  }
                ><.icon name="hero-x-mark" class="size-4" /></.button>
              </.list_row>
            </.data_list>
            <.empty_state :if={visible_students(@classroom, @query) == []}>
              <.icon name="hero-user-group" class="size-8" /><h2>
                {if @query == "",
                  do: gettext("No students yet"),
                  else: gettext("No matching students")}
              </h2><p>
                {if @query == "",
                  do: gettext("Share the classroom link to let your students join."),
                  else: gettext("Try another name, student ID, or GitHub username.")}
              </p>
            </.empty_state>
          <% end %>
        <% true -> %>
          <.empty_state>
            <h1>{gettext("Classroom not found")}</h1><.button patch="/classrooms">{gettext(
              "My classrooms"
            )}</.button>
          </.empty_state>
      <% end %>
    </.page_content>
    <WorkspaceLayout.footer links={@footer_links} />
  </div>
  <.modal
    :if={@modal}
    id="class-modal"
    dialog_id="class-dialog"
    title_id="class-modal-title"
    title={modal_title(@modal)}
    class={
      modal?(@modal, "test_results") &&
        "w-[640px] [&_[data-ui~=grading]]:border [&_[data-ui~=grading]]:border-line [&_[data-ui~=grading]]:rounded-[9px] [&_[data-ui~=grading]]:overflow-hidden"
    }
  >
    <.notice
      :if={@error}
      kind="error"
      id="class-modal-error"
      role="alert"
    >
      {@error}
    </.notice>
    <.notice
      :if={@notice}
      kind="success"
      role="status"
    >
      {@notice}
    </.notice>
    <%= cond do %>
      <% modal?(@modal, "test_results") -> %>
        <% subject = Enum.find(@assignment_subjects, &(&1.id == elem(@modal, 1))) %>
        <%= if subject do %>
          <p class="font-semibold mb-[16px]">
            {if subject.team,
              do: subject.team.name,
              else: subject.user.student_name || subject.user.name || subject.user.login}
          </p>
          <GradingComponents.results
            id="submission-test-results"
            tests={@assignment_record.tests}
            subject={subject}
          />
        <% else %>
          <p>{gettext("This submission is no longer available.")}</p>
        <% end %>
      <% modal?(@modal, "create") or modal?(@modal, "edit") -> %>
        <form
          phx-submit="save_class"
          id="class-form"
          class="grid gap-[18px]"
        >
          <.field>
            {gettext("Classroom name")}<.input
              name="class[name]"
              aria-invalid={if :name in @class_form_errors, do: "true"}
              aria-describedby={if :name in @class_form_errors, do: "class-modal-error"}
              required
              maxlength="100"
              value={editing_value(assigns, :title)}
              placeholder={gettext("e.g. Programming I")}
            />
          </.field>
          <.field>
            {gettext("Course code")}<.input
              name="class[code]"
              aria-invalid={if :code in @class_form_errors, do: "true"}
              aria-describedby={if :code in @class_form_errors, do: "class-modal-error"}
              required
              maxlength="80"
              value={editing_value(assigns, :code)}
              placeholder="420-110"
            />
          </.field>
          <div class="grid grid-cols-[1fr_1fr] gap-[16px] max-[480px]:grid-cols-1">
            <.field>
              {gettext("Semester (optional)")}
              <.input
                type="select"
                name="class[semester]"
                aria-invalid={if :semester in @class_form_errors, do: "true"}
                aria-describedby={if :semester in @class_form_errors, do: "class-modal-error"}
              >
                <option value="">{gettext("No semester")}</option>
                <option
                  :if={legacy_term?(assigns)}
                  value="legacy"
                  selected={editing_value(assigns, :semester) in [nil, "legacy"]}
                >
                  {@classroom.session}
                </option>
                <option
                  :for={{label, value} <- Presentation.semester_options()}
                  value={value}
                  selected={editing_value(assigns, :semester) == value}
                >
                  {label}
                </option>
              </.input>
            </.field>
            <.field>
              {gettext("Year (optional)")}
              <.input
                type="text"
                name="class[academic_year]"
                aria-invalid={if :academic_year in @class_form_errors, do: "true"}
                aria-describedby={
                  if :academic_year in @class_form_errors, do: "class-modal-error"
                }
                value={editing_value(assigns, :academic_year)}
                maxlength="20"
              />
            </.field>
          </div>
          <.field>
            {gettext("Description (optional)")}
            <.input
              type="textarea"
              name="class[description]"
              rows="3"
              maxlength="500"
              value={editing_value(assigns, :description)}
            />
          </.field>
          <.field>
            {gettext("GitHub organization")}
            <.input
              type="select"
              name="class[github_connection_id]"
              required
              disabled={
                classroom_organization_locked?(assigns) or
                  (classroom_organizations(@organizations) == [] and not @preview?)
              }
            >
              <option
                value=""
                selected={selected_organization(assigns) in [nil, ""]}
              >
                {gettext("Select an organization")}
              </option><option
                :for={organization <- classroom_organizations(@organizations)}
                value={if(is_map(organization), do: organization.id, else: organization)}
                selected={
                  to_string(selected_organization(assigns) || "") ==
                    to_string(if(is_map(organization), do: organization.id, else: organization))
                }
              >
                {if(is_map(organization), do: organization.login, else: organization)}
              </option>
            </.input>
          </.field>
          <.field_hint :if={classroom_organization_locked?(assigns)}>
            {gettext("The GitHub organization cannot change after assignments have been created.")}
          </.field_hint>
          <.field_hint :if={classroom_organizations(@organizations) == [] and not @preview?}>
            {gettext("Connect a GitHub organization in settings before creating a classroom.")}
            <.link patch="/teacher/settings?section=organizations">{gettext(
              "Open organization settings"
            )}</.link>
          </.field_hint>
          <.modal_actions>
            <.button type="button" phx-click="close">{gettext("Cancel")}</.button><.button
              type="submit"
              variant="primary"
            >{if modal?(
                   @modal,
                   "create"
                 ),
                 do: gettext("Create classroom"),
                 else: gettext("Save changes")}</.button>
          </.modal_actions>
        </form>
      <% modal?(@modal, "clone_all") -> %>
        <div class={[
          "text-[14px] leading-[1.5] [&_ol]:pl-[20px] [&_ol]:my-[22px] [&_ol]:mx-0 [&_li+li]:mt-[22px]",
          "[&_h3]:text-[14px] [&_h3]:font-semibold [&_h3]:mb-[6px] [&_p]:text-muted [&_p]:my-[6px] [&_p]:mx-0",
          "[&_a]:underline [&_a]:underline-offset-[3px] [&_code]:text-[12px] [&_code]:wrap-anywhere",
          "[&_code]:whitespace-pre-wrap [&_pre]:bg-surface-heading [&_pre]:border [&_pre]:border-line",
          "[&_pre]:rounded-[6px] [&_pre]:mt-[10px] [&_pre]:p-[12px]"
        ]}>
          <p>
            {gettext("Download every student repository for this assignment into a local folder.")}
          </p>
          <ol>
            <li>
              <h3>{gettext("Install GitHub CLI")}</h3><p>
                <a href="https://cli.github.com/" target="_blank" rel="noopener noreferrer">{gettext(
                  "Get GitHub CLI"
                )}</a>
              </p><code>gh auth login</code>
            </li>
            <li>
              <h3>{gettext("Install the GradePush extension")}</h3><p>
                {gettext(
                  "The extension is not available yet. Installation instructions will appear here."
                )}
              </p>
            </li>
            <li>
              <h3>{gettext("Clone the assignment repositories")}</h3><p>
                {local(@classroom.title, @locale)} · {local(@assignment.title, @locale)}
              </p><pre aria-label={gettext("Command preview")}><code>gh gradepush clone --assignment {@assignment.key} --classroom {@classroom.slug}</code></pre>
            </li>
          </ol>
          <p class="text-muted text-[12px] mt-[16px] mb-0 mx-0">
            {gettext("Preview only. Bulk cloning and this command are not available yet.")}
          </p>
        </div>
        <.modal_actions>
          <.button phx-click="close">{gettext("Close")}</.button>
        </.modal_actions>
      <% modal?(@modal, "assignment_invite") -> %>
        <p>
          {gettext(
            "Share this link with your students. Accepting the assignment joins the classroom and creates their repository."
          )}
        </p>
        <ClassroomComponents.invitation_link
          :if={@invitation_url || @preview? || GradePush.Demo.enabled?()}
          id="assignment-invitation"
          disabled={GradePush.Demo.enabled?()}
          label={gettext("Assignment invitation link")}
          url={
            if GradePush.Demo.enabled?(),
              do: "",
              else:
                @invitation_url ||
                  "https://gradepush.example/join/assignment/#{@assignment.key}"
          }
          status={@copy_status}
        />
        <.field_hint :if={GradePush.Demo.enabled?()}>
          {gettext("Invitations are disabled in demo mode.")}
        </.field_hint>
        <p
          :if={@preview? && !GradePush.Demo.enabled?()}
          id="assignment-invitation-note"
          class="text-muted text-[12px] mt-[16px] mb-0 mx-0"
        >
          {gettext("Example link only. Invitations are not active in this preview.")}
        </p>
        <.modal_actions>
          <.button phx-click="close">{gettext("Close")}</.button>
        </.modal_actions>
      <% modal?(@modal, "invite") -> %>
        <p>
          {gettext(
            "Students sign in with GitHub and enter their name and student ID to join your classroom."
          )}
        </p>
        <ClassroomComponents.invitation_link
          :if={@invitation_url || @preview?}
          id="invitation"
          label={gettext("Classroom invitation link")}
          url={@invitation_url || "https://gradepush.example/join/classroom/#{@classroom.slug}"}
          status={@copy_status}
        />
        <p
          :if={@preview?}
          id="invitation-note"
          class="text-muted text-[12px] mt-[16px] mb-0 mx-0"
        >
          {gettext("Example link only. Invitations are not active in this preview.")}
        </p>
        <.modal_actions>
          <.button phx-click="close">{gettext("Close")}</.button>
        </.modal_actions>
      <% modal?(@modal, "teachers") -> %>
        <p>{gettext("All teachers in this classroom have the same permissions.")}</p>
        <ul
          data-ui="teacher-list"
          class={[
            "list-none p-0 my-[22px] mx-0 [&_li]:flex [&_li]:items-center [&_li]:border-b [&_li]:border-b-line",
            "[&_li]:py-[12px] [&_li]:px-0 [&_li]:gap-[12px] [&_strong]:text-[13px] [&_strong]:font-[550]",
            "[&_[data-variant=icon]]:ml-auto"
          ]}
        >
          <li :for={teacher <- @classroom.teachers}>
            <.user_avatar src={Map.get(teacher, :avatar_url)} size="small">
              {teacher.initials}
            </.user_avatar><strong>{teacher.name}</strong><span
              :if={not not_current_teacher?(teacher, assigns)}
              class="ml-auto text-muted text-[12px]"
            >{gettext("You")}</span><.button
              :if={not_current_teacher?(teacher, assigns)}
              id={teacher_remove_id(teacher)}
              variant="icon"
              aria-label={gettext("Remove %{name}", name: teacher.name)}
              phx-click="request_teacher_removal"
              phx-value-teacher={teacher_option_value(teacher)}
            ><.icon name="hero-x-mark" class="size-4" /></.button>
          </li>
        </ul>
        <div
          :if={@pending_teacher}
          id="teacher-removal-confirmation"
          class="border border-subtle rounded-[8px] bg-[#f6f7fa] mb-[20px] p-[16px] [&_[data-ui~=modal-actions]]:mt-[16px]"
          role="group"
          aria-labelledby="teacher-removal-question"
          phx-mounted={JS.focus(to: "#cancel-teacher-removal")}
        >
          <p id="teacher-removal-question" role="status">
            {gettext("Remove %{name} from this classroom?", name: @pending_teacher.name)}
          </p>
          <.modal_actions>
            <.button
              id="cancel-teacher-removal"
              phx-click={
                JS.push("cancel_teacher_removal")
                |> JS.focus(to: "##{teacher_remove_id(@pending_teacher)}")
              }
            >{gettext("Cancel")}</.button>
            <.button
              variant="danger"
              phx-click={JS.push("remove_teacher") |> JS.focus(to: "#class-modal-title")}
            >{gettext("Remove")}</.button>
          </.modal_actions>
        </div>
        <form
          :if={@pending_teacher == nil and @available_classroom_teachers != []}
          phx-submit="add_teacher"
          class="grid gap-[18px]"
        >
          <.field>
            {gettext("Add a colleague")}
            <.input type="select" name="teacher">
              <option
                :for={teacher <- @available_classroom_teachers}
                value={teacher_option_value(teacher)}
              >
                {teacher_name(teacher)}
              </option>
            </.input>
          </.field><.button type="submit" variant="primary">{gettext("Add to classroom")}</.button>
        </form>
        <p :if={@preview?} class="text-muted text-[12px] mt-[16px] mb-0 mx-0">
          {gettext("Teachers are added locally in this preview. No invitation is sent.")}
        </p>
      <% modal?(@modal, "connect_organization") -> %>
        <p>
          {gettext(
            "Authorize GradePush on GitHub to create assignment repositories in your organization."
          )}
        </p>
        <div
          :if={@preview?}
          class="text-muted text-[12px] mt-[16px] mb-0 mx-0"
        >
          {gettext(
            "GitHub connections are unavailable in this preview. No permissions will be changed."
          )}
        </div>
        <form
          :if={!@preview? and @available_organizations != []}
          phx-submit="connect_organization"
          class="grid gap-[18px]"
        >
          <.field>
            {gettext("Installed organization")}
            <.input type="select" name="organization" required>
              <option value="" selected>{gettext("Select an organization")}</option>
              <option
                :for={organization <- @available_organizations}
                value={organization.installation_id}
              >
                {organization.login}
              </option>
            </.input>
          </.field>
          <.field>
            {gettext("Who can use this connection?")}
            <.input type="select" name="sharing_scope">
              <option value="private">{gettext("Only me")}</option>
              <option value="institution">{gettext("All institution teachers")}</option>
            </.input>
          </.field>
          <.modal_actions>
            <.button type="button" phx-click="close">{gettext("Cancel")}</.button>
            <.button type="submit" variant="primary">{gettext("Connect organization")}</.button>
          </.modal_actions>
        </form>
        <div
          :if={!@preview? and @available_organizations == []}
          class="text-muted text-[13px] leading-[1.6] py-[20px] px-[22px] m-0 max-[760px]:p-[18px]"
        >
          <p>{gettext("No GitHub organization is installed for GradePush yet.")}</p>
          <.button
            :if={@github_app_install_url}
            variant="primary"
            href={@github_app_install_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {gettext("Install GradePush on GitHub")}<.icon
              name="hero-arrow-top-right-on-square"
              class="size-4"
            />
          </.button>
          <p :if={!@github_app_install_url}>
            {gettext("Ask the platform administrator to connect GitHub first.")}
          </p>
        </div>
        <.modal_actions :if={@preview? or @available_organizations == []}>
          <.button phx-click="close">{gettext("Close")}</.button>
          <.button :if={@preview?} type="submit" variant="primary" disabled>{gettext(
            "Continue on GitHub"
          )}</.button>
        </.modal_actions>
      <% modal?(@modal, "remove") -> %>
        <p>
          {gettext("Remove %{name} from this classroom?",
            name: selected_student(@classroom, @modal).name
          )}
        </p>
        <p class="rounded-[7px] bg-[#f6f8fb] mt-[16px] mb-[22px] text-[13px] p-[14px] mx-0">
          {gettext(
            "Their repositories and GitHub access will be kept. If they rejoin, they will recover their existing work."
          )}
        </p>
        <.modal_actions>
          <.button phx-click="close">{gettext("Cancel")}</.button><.button
            variant="danger"
            phx-click="remove_student"
          >{gettext("Remove from classroom")}</.button>
        </.modal_actions>
      <% modal?(@modal, "teams") -> %>
        <p>
          {gettext(
            "Assign students to teams. Students receive their team when they accept the assignment."
          )}
        </p>
        <form
          data-ui="team-create-form"
          phx-submit="create_team"
          class="grid gap-[18px]"
        >
          <.field>
            {gettext("Team name")}<.input
              name="team[name]"
              required
              maxlength="100"
              placeholder={gettext("e.g. Team 1")}
            />
          </.field><.button type="submit" variant="primary"><.icon
            name="hero-plus"
            class="size-4"
          />{gettext("Create team")}</.button>
        </form>
        <div
          :if={@teams != []}
          data-ui="teacher-list"
          class={[
            "list-none grid p-0 my-[22px] mx-0 gap-[18px] [&_li]:flex [&_li]:items-center [&_li]:border-b",
            "[&_li]:border-b-line [&_li]:py-[6px] [&_li]:px-0 [&_li]:gap-[10px] [&_strong]:text-[13px]",
            "[&_strong]:font-[550] [&_[data-variant=icon]]:ml-auto [&>section]:pb-[18px] [&>section]:border-b",
            "[&>section]:border-b-line [&_ul]:list-none [&_ul]:mt-0 [&_ul]:mb-[12px] [&_ul]:p-0 [&_ul]:mx-0"
          ]}
        >
          <section :for={team <- @teams} id={"managed-team-#{team.id}"}>
            <div class="flex justify-between items-baseline mb-[10px] gap-[12px] [&_span]:text-muted [&_span]:text-[12px]">
              <strong>{team.name}</strong><span>
                {ngettext("%{count} student", "%{count} students", length(team.members))}
              </span>
            </div>
            <ul :if={team.members != []}>
              <li :for={student <- team.members}>
                <.user_avatar src={Map.get(student, :avatar_url)} size="small">
                  {student.initials}
                </.user_avatar><strong>{student.name}</strong>
              </li>
            </ul>
            <form
              :if={team.can_add? and unassigned_students(@members, @teams) != []}
              phx-submit="add_team_member"
              class="grid grid-cols-[minmax(0,1fr)_auto] [align-items:end] gap-[18px]"
            >
              <.input type="hidden" name="team_id" value={team.id} />
              <.field>
                {gettext("Add a student")}
                <.input type="select" name="student_id" required>
                  <option
                    :for={student <- unassigned_students(@members, @teams)}
                    value={student.id}
                  >
                    {student.name} (@{student.handle})
                  </option>
                </.input>
              </.field><.button type="submit">{gettext("Add to team")}</.button>
            </form>
            <.field_hint :if={not team.can_add?}>
              {gettext("This team has reached its member limit.")}
            </.field_hint>
          </section>
        </div>
        <div
          :if={@teams == []}
          class="text-muted text-[13px] leading-[1.6] py-[20px] px-[22px] m-0 max-[760px]:p-[18px]"
        >
          {gettext("No teams yet. Create a team to start assigning students.")}
        </div>
        <.modal_actions>
          <.button phx-click="close">{gettext("Done")}</.button>
        </.modal_actions>
      <% modal?(@modal, "deadline_extension") -> %>
        <% subject = Enum.find(@assignment_subjects, &(&1.id == elem(@modal, 1))) %>
        <%= if subject do %>
          <div class={[
            "mb-[22px] leading-[1.5] text-muted text-[13px] [&_p]:m-0 [&_[data-ui~=extension-owner]]:text-ink",
            "[&_[data-ui~=extension-owner]]:text-[15px] [&_[data-ui~=extension-owner]]:font-semibold",
            "[&_[data-ui~=extension-owner]]:mb-[6px]"
          ]}>
            <p data-ui="extension-owner">
              {if subject.team,
                do: subject.team.name,
                else: subject.user.student_name || subject.user.name || subject.user.login}
            </p>
            <p>
              {gettext("Assignment deadline: %{date}", date: local(@assignment.due, @locale))}
            </p>
          </div>
          <form
            id="deadline-extension-form"
            phx-change="validate_extension"
            phx-submit="save_extension"
            class="grid gap-[18px]"
          >
            <.field>
              {gettext("Revised deadline")}
              <.input
                type="datetime-local"
                name="extension[deadline]"
                min={@assignment.deadline_local}
                value={@extension_params["deadline"]}
                required
              />
            </.field>
            <.modal_actions>
              <.button type="button" phx-click="close">{gettext("Cancel")}</.button>
              <.button type="submit" variant="primary">{gettext("Save deadline")}</.button>
            </.modal_actions>
            <div
              :if={extension_set?(assigns)}
              class="border-t border-t-line pt-[16px]"
            >
              <.button
                data-ui="clear-extension"
                type="button"
                class="underline-offset-[3px] text-left leading-[1.5] hover:text-brand hover:underline"
                phx-click="clear_extension"
              >{gettext("Clear extension and use the assignment deadline")}</.button>
            </div>
          </form>
        <% else %>
          <p>{gettext("This submission is no longer available.")}</p>
        <% end %>
    <% end %>
  </.modal>
</.page>
