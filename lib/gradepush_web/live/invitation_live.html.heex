<div class="class-preview">
  <div class="cp-shell">
    <WorkspaceLayout.public_header locale={@locale} path={@path} />
    <main class="cp-main" id="invitation-content">
      <%= if @invitation do %>
        <div class="cp-heading">
          <div>
            <p class="cp-context">{gettext("Invitation")}</p><h1>{title(@invitation)}</h1>
          </div>
        </div>
        <section class="cp-admin-panel">
          <div class="cp-admin-panel-heading">
            <h2>
              {if @kind == "assignment", do: gettext("Accept assignment"), else: gettext("Join")}
            </h2>
          </div>
          <div class="cp-admin-settings-form">
            <p :if={@kind == "assignment"}>
              {gettext(
                "Accepting this assignment joins the classroom and creates your GitHub repository."
              )}
            </p>
            <p :if={@kind == "teacher"}>
              {gettext("Join this institution as a teacher using your GitHub account.")}
            </p>
            <p :if={@error} role="alert" class="cp-error">{@error}</p>
            <.form for={@profile} id="accept-invitation-form" phx-submit="accept" class="cp-form">
              <%= if @kind != "teacher" do %>
                <label>{gettext("Name")}<input
                  name="profile[name]"
                  value={@profile[:name].value}
                  required
                  maxlength="160"
                  autocomplete="name"
                /></label>
                <label>{gettext("Student ID")}<input
                  name="profile[student_id]"
                  value={@profile[:student_id].value}
                  required
                  maxlength="80"
                  autocomplete="off"
                /></label>
                <%= if team_assignment?(@invitation) do %>
                  <label>{gettext("Join a team")}<select name="profile[team_id]"><option value="">
                    {gettext("Create a new team")}
                  </option><option
                    :for={team <- Map.get(@invitation, :team_options, [])}
                    value={team.id}
                  >
                    {team.name}
                  </option></select></label>
                  <label>{gettext("New team name")}<input
                    name="profile[team_name]"
                    maxlength="120"
                  /></label>
                <% end %>
              <% end %>
              <div class="cp-modal-actions">
                <button class="cp-button cp-primary" phx-disable-with={gettext("Joining…")}>{if @kind ==
                                                                                                  "assignment",
                                                                                                do:
                                                                                                  gettext(
                                                                                                    "Accept assignment"
                                                                                                  ),
                                                                                                else:
                                                                                                  gettext(
                                                                                                    "Join"
                                                                                                  )}</button>
              </div>
            </.form>
          </div>
        </section>
        <section :if={@kind == "assignment"} class="cp-admin-panel">
          <div class="cp-admin-panel-heading">
            <h2>{gettext("Assignment instructions")}</h2>
          </div><div class="cp-admin-settings-form cp-markdown">
            {Markdown.render(@invitation.assignment.instructions, 2)}
          </div>
        </section>
      <% else %>
        <div class="cp-empty">
          <h1>{gettext("Invitation unavailable")}</h1><p>
            {gettext(
              "This invitation has expired or is no longer available. Ask your teacher for a new link."
            )}
          </p><.link navigate="/" class="cp-button">{gettext("My classrooms")}</.link>
        </div>
      <% end %>
    </main>
  </div>
</div>
