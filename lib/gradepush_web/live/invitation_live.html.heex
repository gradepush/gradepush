<.page public>
  <div class="min-h-screen flex flex-col">
    <WorkspaceLayout.public_header locale={@locale} path={@path} />
    <.page_content id="invitation-content">
      <%= if @invitation do %>
        <.page_heading>
          <div>
            <.eyebrow>
              {gettext("Invitation")}
            </.eyebrow><h1>{title(@invitation)}</h1>
          </div>
        </.page_heading>
        <.panel>
          <.panel_heading>
            <h2>
              {if @kind == "assignment", do: gettext("Accept assignment"), else: gettext("Join")}
            </h2>
          </.panel_heading>
          <div class="max-w-[660px] p-[24px] max-[760px]:p-[18px]">
            <p :if={@kind == "assignment"}>
              {gettext(
                "Accepting this assignment joins the classroom and creates your GitHub repository."
              )}
            </p>
            <p :if={@kind == "teacher"}>
              {gettext("Join this institution as a teacher using your GitHub account.")}
            </p>
            <.notice
              :if={@error}
              kind="error"
              role="alert"
            >
              {@error}
            </.notice>
            <.form
              for={@profile}
              id="accept-invitation-form"
              phx-submit="accept"
              class="grid gap-[18px]"
            >
              <%= if @kind != "teacher" do %>
                <.field>
                  {gettext("Name")}<.input
                    name="profile[name]"
                    value={@profile[:name].value}
                    required
                    maxlength="160"
                    autocomplete="name"
                  />
                </.field>
                <.field>
                  {gettext("Student ID")}<.input
                    name="profile[student_id]"
                    value={@profile[:student_id].value}
                    required
                    maxlength="80"
                    autocomplete="off"
                  />
                </.field>
                <%= if team_assignment?(@invitation) do %>
                  <.field>
                    {gettext("Join a team")}
                    <.input type="select" name="profile[team_id]">
                      <option value="">
                        {gettext("Create a new team")}
                      </option><option
                        :for={team <- Map.get(@invitation, :team_options, [])}
                        value={team.id}
                      >
                        {team.name}
                      </option>
                    </.input>
                  </.field>
                  <.field>
                    {gettext("New team name")}<.input
                      name="profile[team_name]"
                      maxlength="120"
                    />
                  </.field>
                <% end %>
              <% end %>
              <.modal_actions>
                <.button type="submit" variant="primary" phx-disable-with={gettext("Joining…")}>{if @kind ==
                                                                                                      "assignment",
                                                                                                    do:
                                                                                                      gettext(
                                                                                                        "Accept assignment"
                                                                                                      ),
                                                                                                    else:
                                                                                                      gettext(
                                                                                                        "Join"
                                                                                                      )}</.button>
              </.modal_actions>
            </.form>
          </div>
        </.panel>
        <.panel :if={@kind == "assignment"}>
          <.panel_heading>
            <h2>{gettext("Assignment instructions")}</h2>
          </.panel_heading><div class="max-w-[660px] markdown p-[24px] max-[760px]:p-[18px]">
            {Markdown.render(@invitation.assignment.instructions, 2)}
          </div>
        </.panel>
      <% else %>
        <.empty_state>
          <h1>{gettext("Invitation unavailable")}</h1><p>
            {gettext(
              "This invitation has expired or is no longer available. Ask your teacher for a new link."
            )}
          </p><.button navigate="/">{gettext("My classrooms")}</.button>
        </.empty_state>
      <% end %>
    </.page_content>
    <WorkspaceLayout.footer context={:public} links={@footer_links} />
  </div>
</.page>
