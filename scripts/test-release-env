#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
release_env="$(pwd)/rel/env.sh.eex"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

export RELEASE_ROOT="$scratch/release"
export GRADEPUSH_DATA_DIR="$scratch/data"
unset SECRET_KEY_BASE CREDENTIAL_ENCRYPTION_KEY RELEASE_COOKIE RELEASE_TMP

sh -eu -c '. "$1"; test -n "$SECRET_KEY_BASE"; test -n "$RELEASE_COOKIE"; test "$(printf %s "$CREDENTIAL_ENCRYPTION_KEY" | base64 -d | wc -c | tr -d " ")" = 32' sh "$release_env"
cp -R "$GRADEPUSH_DATA_DIR" "$scratch/first"
sh -eu -c '. "$1"' sh "$release_env"
diff -r "$scratch/first" "$GRADEPUSH_DATA_DIR"
insecure_files=$(find "$GRADEPUSH_DATA_DIR" -type f ! -perm 600)
test -z "$insecure_files"

export GRADEPUSH_DATA_DIR="$scratch/external"
SECRET_KEY_BASE=external-session CREDENTIAL_ENCRYPTION_KEY=external-credentials RELEASE_COOKIE=external-cookie \
  sh -eu -c '. "$1"; test "$SECRET_KEY_BASE" = external-session; test "$CREDENTIAL_ENCRYPTION_KEY" = external-credentials; test "$RELEASE_COOKIE" = external-cookie' sh "$release_env"
test ! -e "$GRADEPUSH_DATA_DIR"

mkdir "$scratch/bin"
cat > "$scratch/bin/head" <<'SH'
#!/bin/sh
test "$1" = -c
test "$2" = 48
i=0
while [ "$i" -lt 48 ]; do
  printf '\373'
  i=$((i + 1))
done
SH
chmod +x "$scratch/bin/head"
export GRADEPUSH_DATA_DIR="$scratch/leading-plus"
PATH="$scratch/bin:$PATH" SECRET_KEY_BASE=external-session CREDENTIAL_ENCRYPTION_KEY=external-credentials \
  sh -eu -c '. "$1"; case "$RELEASE_COOKIE" in gp_+*) ;; *) exit 1 ;; esac; erl -noshell -setcookie "$RELEASE_COOKIE" -eval "halt()."' sh "$release_env"

export GRADEPUSH_DATA_DIR="$scratch/legacy"
cp -R "$scratch/first" "$GRADEPUSH_DATA_DIR"
printf '%s' '+aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' > "$GRADEPUSH_DATA_DIR/release_cookie"
cp -R "$GRADEPUSH_DATA_DIR" "$scratch/legacy-first"
for attempt in 1 2; do
  sh -eu -c '. "$1"; test "$RELEASE_COOKIE" = "gp_$(cat "$GRADEPUSH_DATA_DIR/release_cookie")"; erl -noshell -setcookie "$RELEASE_COOKIE" -eval "halt()."' sh "$release_env"
done
diff -r "$scratch/legacy-first" "$GRADEPUSH_DATA_DIR"
printf '%s' 'legacy-safe-cookie' > "$GRADEPUSH_DATA_DIR/release_cookie"
sh -eu -c '. "$1"; test "$RELEASE_COOKIE" = legacy-safe-cookie' sh "$release_env"

export GRADEPUSH_DATA_DIR="$scratch/concurrent"
sh -eu -c '. "$1"' sh "$release_env" &
first=$!
sh -eu -c '. "$1"' sh "$release_env" &
second=$!
wait "$first"
wait "$second"
test "$(find "$GRADEPUSH_DATA_DIR" -type f | wc -l | tr -d ' ')" = 3

printf '%s\n' 'Release secrets: generation, permissions, reuse, overrides, new and legacy cookies, and concurrent initialization passed.'
